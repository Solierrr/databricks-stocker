{
  "datasets": [
    {
      "name": "a3010001",
      "displayName": "Indicadores administrativos",
      "queryLines": [
        "SELECT\n",
        "  COALESCE((SELECT SUM(amount) FROM workspace.core.charge WHERE status = 'PAID'), 0) AS paid_charges,\n",
        "  COALESCE((SELECT SUM(amount) FROM workspace.core.charge WHERE status = 'PENDING'), 0) AS pending_charges,\n",
        "  COALESCE((SELECT SUM(pi.negotiated_price * pi.quantity)\n",
        "    FROM workspace.core.proposal p\n",
        "    JOIN workspace.core.proposal_item pi ON pi.fk_proposal = p.id\n",
        "    WHERE p.status = 'ACCEPTED' AND pi.negotiated_price IS NOT NULL), 0) AS accepted_negotiated_value,\n",
        "  (SELECT COUNT(*) FROM workspace.core.supplier WHERE status = 'ACTIVE') AS active_suppliers,\n",
        "  (SELECT COUNT(*) FROM workspace.core.requester) AS requesters_total,\n",
        "  (SELECT COUNT(*) FROM workspace.core.proposal WHERE status = 'OPEN') AS open_proposals"
      ]
    },
    {
      "name": "a3010002",
      "displayName": "Cobranças pagas por mês",
      "queryLines": [
        "SELECT date_trunc('MONTH', payment_date) AS month, SUM(amount) AS paid_amount\n",
        "FROM workspace.core.charge\n",
        "WHERE status = 'PAID' AND payment_date IS NOT NULL\n",
        "GROUP BY date_trunc('MONTH', payment_date)\n",
        "ORDER BY month"
      ]
    },
    {
      "name": "a3010003",
      "displayName": "Propostas aceitas por mês de criação",
      "queryLines": [
        "SELECT date_trunc('MONTH', p.created_at) AS month,\n",
        "       SUM(pi.negotiated_price * pi.quantity) AS negotiated_value\n",
        "FROM workspace.core.proposal p\n",
        "JOIN workspace.core.proposal_item pi ON pi.fk_proposal = p.id\n",
        "WHERE p.status = 'ACCEPTED' AND pi.negotiated_price IS NOT NULL\n",
        "GROUP BY date_trunc('MONTH', p.created_at)\n",
        "ORDER BY month"
      ]
    },
    {
      "name": "a3010004",
      "displayName": "Propostas por status",
      "queryLines": [
        "SELECT status, COUNT(*) AS proposal_count\n",
        "FROM workspace.core.proposal\n",
        "GROUP BY status\n",
        "ORDER BY proposal_count DESC"
      ]
    },
    {
      "name": "a3010005",
      "displayName": "Assinaturas por status",
      "queryLines": [
        "SELECT status, COUNT(*) AS subscription_count\n",
        "FROM workspace.core.subscription\n",
        "GROUP BY status"
      ]
    },
    {
      "name": "a3010006",
      "displayName": "Assinantes por plano e ciclo",
      "queryLines": [
        "SELECT concat(cp.name, ' (', cp.cycle, ')') AS plan_cycle,\n",
        "       COUNT(sub.id) AS subscriber_count\n",
        "FROM workspace.core.company_plans cp\n",
        "LEFT JOIN workspace.core.subscription sub ON sub.fk_plan = cp.id\n",
        "GROUP BY cp.name, cp.cycle\n",
        "ORDER BY subscriber_count DESC"
      ]
    },
    {
      "name": "a3010007",
      "displayName": "Cobranças pagas por método",
      "queryLines": [
        "SELECT payment_method, SUM(amount) AS paid_amount\n",
        "FROM workspace.core.charge\n",
        "WHERE status = 'PAID'\n",
        "GROUP BY payment_method\n",
        "ORDER BY paid_amount DESC"
      ]
    },
    {
      "name": "a3010008",
      "displayName": "Modelos por status",
      "queryLines": [
        "SELECT status, COUNT(*) AS model_count\n",
        "FROM workspace.core.model\n",
        "GROUP BY status"
      ]
    },
    {
      "name": "a3010009",
      "displayName": "Fornecedores por valor negociado",
      "queryLines": [
        "SELECT co.trade_name AS supplier_name,\n",
        "       SUM(pi.negotiated_price * pi.quantity) AS negotiated_value\n",
        "FROM workspace.core.proposal_item pi\n",
        "JOIN workspace.core.offer o ON o.id = pi.fk_offer\n",
        "JOIN workspace.core.supplier s ON s.id = o.fk_supplier\n",
        "JOIN workspace.core.company co ON co.id = s.fk_company\n",
        "JOIN workspace.core.proposal p ON p.id = pi.fk_proposal\n",
        "WHERE p.status = 'ACCEPTED' AND pi.negotiated_price IS NOT NULL\n",
        "GROUP BY co.trade_name\n",
        "ORDER BY negotiated_value DESC\n",
        "LIMIT 20"
      ]
    },
    {
      "name": "a3010010",
      "displayName": "Cobranças por método e status",
      "queryLines": [
        "SELECT payment_method, status, COUNT(*) AS charge_count,\n",
        "       SUM(amount) AS charge_amount\n",
        "FROM workspace.core.charge\n",
        "GROUP BY payment_method, status\n",
        "ORDER BY payment_method, status"
      ]
    },
    {
      "name": "a3010011",
      "displayName": "Itens aceitos sem preço negociado",
      "queryLines": [
        "SELECT COUNT(*) AS unpriced_accepted_items\n",
        "FROM workspace.core.proposal_item pi\n",
        "JOIN workspace.core.proposal p ON p.id = pi.fk_proposal\n",
        "WHERE p.status = 'ACCEPTED' AND pi.negotiated_price IS NULL"
      ]
    }
  ],
