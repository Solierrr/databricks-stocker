{
  "name": "manual-medallion-gold-export",
  "max_concurrent_runs": 1,
  "tasks": [
    {
      "task_key": "bronze_silver_gold",
      "notebook_task": {
        "notebook_path": "/Workspace/Users/<workspace-user>/databricks-stocker/pipelines/medallion/transformations/medallion",
        "source": "WORKSPACE",
        "base_parameters": {
          "catalog": "analytics",
          "source_mode": "manual",
          "fornecedores_path": "/Volumes/analytics/bronze_core/manual_ingestion/fornecedores.xlsx",
          "admins_path": "/Volumes/analytics/bronze_core/manual_ingestion/admins.xlsx",
          "allow_replace_existing": "false"
        }
      }
    },
    {
      "task_key": "analytics_export",
      "depends_on": [{"task_key": "bronze_silver_gold"}],
      "notebook_task": {
        "notebook_path": "/Workspace/Users/<workspace-user>/databricks-stocker/exports/trigger_gold_sync",
        "source": "WORKSPACE"
      }
    }
  ]
}
